# Maintainer: Chris Lyons <support@boot.industries>
# Template: @PKGVER@ is substituted by .github/workflows/alpine-publish.yml.
# The workflow builds from a tarball of the checked-out tree, so source= is a
# local file staged next to this APKBUILD; `abuild checksum` fills sha512sums.
pkgname=claudezilla
pkgver=@PKGVER@
pkgrel=0
pkgdesc="Firefox browser automation for Claude Code - MCP server and native messaging host"
url="https://github.com/@REPO@"
arch="noarch"
license="MIT"
depends="nodejs"
makedepends="npm zip"
options="!check"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

build() {
	(cd mcp && npm install --omit=dev --ignore-scripts --no-fund --no-audit)
	(cd extension && zip -qr ../claudezilla.xpi .)
}

package() {
	_lib=/usr/lib/claudezilla

	# Native messaging host (no runtime npm dependencies)
	install -d "$pkgdir$_lib/host"
	install -m644 host/index.js host/ipc.js host/protocol.js host/cli.js \
		host/package.json "$pkgdir$_lib/host/"

	# MCP server with vendored dependencies
	install -d "$pkgdir$_lib/mcp"
	cp -r mcp/server.js mcp/package.json mcp/node_modules "$pkgdir$_lib/mcp/"

	# Extension XPI, sideloaded into the headless profile by claudezilla-setup
	install -m644 claudezilla.xpi "$pkgdir$_lib/claudezilla.xpi"

	# Executables
	install -d "$pkgdir/usr/bin"
	printf '#!/bin/sh\nexec /usr/bin/node /usr/lib/claudezilla/host/index.js "$@"\n' \
		> "$pkgdir/usr/bin/claudezilla-host"
	printf '#!/bin/sh\nexec /usr/bin/node /usr/lib/claudezilla/mcp/server.js "$@"\n' \
		> "$pkgdir/usr/bin/claudezilla-mcp"
	chmod 755 "$pkgdir/usr/bin/claudezilla-host" "$pkgdir/usr/bin/claudezilla-mcp"
	install -m755 packaging/common/claudezilla-setup "$pkgdir/usr/bin/claudezilla-setup"

	# System-wide Firefox native messaging manifest
	install -Dm644 packaging/common/claudezilla.json \
		"$pkgdir/usr/lib/mozilla/native-messaging-hosts/claudezilla.json"

	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

sha512sums="@SHA512@  $pkgname-$pkgver.tar.gz"
